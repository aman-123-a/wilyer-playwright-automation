{
  "name": "cms-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright + TypeScript E2E framework for the Wilyer CMS (cms.pocsample.in)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test",
    "smoke": "playwright test --grep @smoke",
    "sanity": "playwright test --grep @sanity",
    "regression": "playwright test --grep @regression",
    "a11y": "playwright test tests/a11y",
    "auth": "playwright test tests/auth",
    "dashboard": "playwright test tests/dashboard",
    "library": "playwright test tests/library",
    "screens": "playwright test tests/screens",
    "groups": "playwright test tests/groups",
    "playlists": "playwright test tests/playlists",
    "reports": "playwright test tests/reports",
    "billing": "playwright test tests/billing",
    "team": "playwright test tests/team",
    "perf:lighthouse": "playwright test perf/lighthouse-audit.spec.ts --project=chromium",
    "perf:k6": "k6 run perf/k6/load-test.js",
    "chromium": "playwright test --project=chromium",
    "firefox": "playwright test --project=firefox",
    "webkit": "playwright test --project=webkit",
    "mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "report": "playwright show-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "codegen": "playwright codegen https://cms.wilyersignage.com/",
    "install:browsers": "playwright install --with-deps",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "lighthouse": "^12.2.0",
    "playwright-lighthouse": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
