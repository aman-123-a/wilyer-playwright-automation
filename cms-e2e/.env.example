# =============================================================================
#  CMS E2E — environment configuration. Copy to `.env` and adjust per machine.
#  Precedence: process.env (CI secrets) > .env file > built-in defaults.
# =============================================================================

# Target application under test
CMS_BASE_URL=https://cms.pocsample.in

# Admin / primary account — FILL IN LOCALLY in your gitignored .env.
# Never commit real credentials to the repo.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Sub-user account (scoped / restricted access) — optional
CMS_SUBUSER_EMAIL=
CMS_SUBUSER_PASSWORD=

# Performance thresholds (ms) — overridable per CI hardware
CMS_PERF_PAGE_LOAD_MS=5000
CMS_PERF_LISTING_LOAD_MS=4000
CMS_API_SLOW_MS=3000

# Behaviour toggles
# When true, suites that mutate live data (create/delete) may run.
CMS_ALLOW_DESTRUCTIVE=false
# When true, console-error and failed-API monitors FAIL the test on violation.
# When false they only warn (useful against a noisy staging build).
CMS_STRICT_MONITORS=false

# Lighthouse minimum scores (0-100)
CMS_LH_PERFORMANCE=50
CMS_LH_ACCESSIBILITY=80
CMS_LH_BEST_PRACTICES=80
CMS_LH_SEO=80
