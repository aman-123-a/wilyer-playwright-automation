{
  "name": "wilyer-qa-automation",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Playwright + TypeScript automation platform for the Wilyer Digital Signage CMS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cms": "cross-env TEST_ENV=cms playwright test",
    "cms2": "cross-env TEST_ENV=cms2 playwright test",
    "cms3": "cross-env TEST_ENV=cms3 playwright test",
    "cms4": "cross-env TEST_ENV=cms4 playwright test",
    "live": "cross-env TEST_ENV=live playwright test",

    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "cross-env PWDEBUG=1 playwright test",

    "smoke": "playwright test --grep @smoke",
    "sanity": "playwright test --grep @sanity",
    "regression": "playwright test --grep @regression",
    "boundary": "playwright test --grep @boundary",
    "negative": "playwright test --grep @negative",
    "security": "playwright test --grep @security",
    "rbac": "playwright test --grep @rbac",
    "a11y": "playwright test --grep @a11y",
    "visual": "playwright test --grep @visual",
    "api": "playwright test --project=api",
    "perf": "playwright test --grep @performance",
    "perf:k6": "k6 run scripts/k6/load-test.js",

    "chromium": "playwright test --project=chromium",
    "firefox": "playwright test --project=firefox",
    "webkit": "playwright test --project=webkit",
    "mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",

    "report": "playwright show-report reports/html",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "trace": "playwright show-trace",

    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check",

    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "docker:build": "docker build -f docker/Dockerfile -t wilyer-qa .",
    "docker:run": "docker compose -f docker/docker-compose.yml run --rm e2e",

    "mcp-server": "node mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.70",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "lighthouse": "^12.2.0",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aman-123-a/wilyer-playwright-automation.git"
  },
  "license": "UNLICENSED"
}
