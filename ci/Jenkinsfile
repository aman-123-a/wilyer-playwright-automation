// =============================================================================
//  Jenkins declarative pipeline — CMS E2E.
//  Runs the suite inside the official Playwright Docker image, publishes the
//  HTML + Allure reports, and archives traces/videos/screenshots on failure.
//  Configure credentials `cms-admin-email` / `cms-admin-password` in Jenkins.
// =============================================================================
pipeline {
  agent {
    docker {
      image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
      args '-u root:root'
    }
  }

  options {
    timeout(time: 60, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    // Target server — resolved to its URLs by config/environments.ts.
    choice(name: 'TEST_ENV', choices: ['cms', 'cms2', 'cms3', 'cms4', 'live'], description: 'Target environment')
    choice(name: 'GREP', choices: ['@regression', '@smoke', '@sanity'], description: 'Tag filter')
    choice(name: 'PROJECT', choices: ['chromium', 'firefox', 'webkit'], description: 'Browser')
  }

  environment {
    TEST_ENV           = "${params.TEST_ENV}"
    CMS_ADMIN_EMAIL    = credentials('cms-admin-email')
    CMS_ADMIN_PASSWORD = credentials('cms-admin-password')
    CMS_STRICT_MONITORS = 'false'
    CI = 'true'
  }

  stages {
    stage('Install') {
      steps {
        sh 'npm ci'
        sh 'npx playwright install --with-deps'
      }
    }
    stage('Test') {
      steps {
        sh "npx playwright test --project=${params.PROJECT} --grep '${params.GREP}'"
      }
    }
  }

  post {
    always {
      junit testResults: "reports/${params.TEST_ENV}/junit.xml", allowEmptyResults: true
      publishHTML(target: [
        reportDir: "reports/${params.TEST_ENV}/html",
        reportFiles: 'index.html',
        reportName: 'Playwright HTML Report',
        keepAll: true, alwaysLinkToLastBuild: true, allowMissing: true
      ])
      archiveArtifacts artifacts: "reports/${params.TEST_ENV}/test-results/**, reports/${params.TEST_ENV}/allure-results/**", allowEmptyArchive: true
    }
  }
}
