# Wilyer Signage CMS suite — copy to `.env` and adjust.
# Precedence: process.env > .env > built-in defaults (config/env.ts)

# Target application
CMS_BASE_URL=https://cms.wilyersignage.com

# Admin / primary account (full access)
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Restricted accounts for RBAC tests (optional — security tests soft-skip if absent)
CMS_VIEWER_EMAIL=viewer@wilyer.com
CMS_VIEWER_PASSWORD=12345
CMS_EDITOR_EMAIL=editor@wilyer.com
CMS_EDITOR_PASSWORD=12345

# Safety: only enable mutations (create/delete/upload) intentionally.
# When false, write tests soft-skip so the suite is safe against production.
CMS_ALLOW_DESTRUCTIVE=false

# When true, console-error / 5xx monitors FAIL the test (vs annotate).
CMS_STRICT_MONITORS=false

# When true, reuse a hand-captured session at .auth/admin.json (OTP/2FA logins).
CMS_MANUAL_AUTH=false

# Perf thresholds (ms)
CMS_PERF_PAGE_LOAD_MS=6000
CMS_API_SLOW_MS=3000
