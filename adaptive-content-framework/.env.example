# =============================================================================
#  Environment configuration for the Adaptive Content framework.
#  Copy to `.env` and adjust per environment. `.env` is git-ignored.
#  Select the active environment with TEST_ENV=dev|staging|prod.
# =============================================================================

# Active environment: dev | staging | prod
TEST_ENV=dev

# --- Dev -------------------------------------------------------------------
DEV_BASE_URL=https://cms.wilyersignage.com
DEV_API_URL=https://v3-5api.wilyersignage.com/v3/cms
DEV_USER_EMAIL=dev@wilyer.com
DEV_USER_PASSWORD=testdev

# --- Staging ---------------------------------------------------------------
STAGING_BASE_URL=https://staging-cms.wilyersignage.com
STAGING_API_URL=https://staging-api.wilyersignage.com/v3/cms
STAGING_USER_EMAIL=
STAGING_USER_PASSWORD=

# --- Production ------------------------------------------------------------
PROD_BASE_URL=https://cms.wilyersignage.com
PROD_API_URL=https://v3-5api.wilyersignage.com/v3/cms
PROD_USER_EMAIL=
PROD_USER_PASSWORD=

# --- Runtime knobs ---------------------------------------------------------
# Worker count. The live CMS is slow — keep this low to avoid nav stalls.
WORKERS=4
# Default transcode/processing poll budget in ms (background jobs are async).
TRANSCODE_TIMEOUT_MS=180000
