{
  "name": "signage-cms-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Playwright + TypeScript automation framework for the Wilyer Digital Signage CMS (cms.pocsample.in)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "smoke": "playwright test --grep @smoke",
    "regression": "playwright test --grep @regression",
    "smoke:auth": "playwright test src/tests/smoke/authentication.smoke.spec.ts",
    "smoke:playlist": "playwright test src/tests/smoke/playlist.smoke.spec.ts",
    "smoke:media": "playwright test src/tests/smoke/media.smoke.spec.ts",
    "smoke:screens": "playwright test src/tests/smoke/screens.smoke.spec.ts",
    "smoke:app": "playwright test src/tests/smoke/application.smoke.spec.ts",
    "chromium": "playwright test --project=chromium",
    "firefox": "playwright test --project=firefox",
    "webkit": "playwright test --project=webkit",
    "report": "playwright show-report playwright-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen https://cms.wilyersignage.com/",
    "install:browsers": "playwright install --with-deps",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.7.0"
  }
}
