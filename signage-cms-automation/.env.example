# =============================================================================
#  Signage CMS Automation — environment configuration.
#  Copy to `.env` and adjust per machine.
#  Precedence: process.env (CI secrets) > .env file > built-in defaults.
# =============================================================================

# Target application under test
CMS_BASE_URL=https://cms.pocsample.in

# Admin / primary account (full access)
CMS_ADMIN_EMAIL=dev@wilyer.com
CMS_ADMIN_PASSWORD=testdev

# Performance thresholds (ms)
CMS_PERF_PAGE_LOAD_MS=5000
CMS_API_SLOW_MS=3000

# Behaviour toggles
# When true, suites that mutate live data (delete/update) may run.
CMS_ALLOW_DESTRUCTIVE=false
# When true, console-error + failed-API monitors FAIL the test on any violation.
# When false they only warn (recommended against a noisy live build).
CMS_STRICT_MONITORS=false
# 5xx responses + uncaught exceptions always fail regardless of STRICT_MONITORS.
CMS_FAIL_ON_SERVER_ERROR=true
