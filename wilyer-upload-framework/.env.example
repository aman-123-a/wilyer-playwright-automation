# ============================================================================
# Wilyer Upload Framework — Environment Configuration (sample)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- Application under test -------------------------------------------------
BASE_URL=https://cms.wilyersignage.com
API_BASE_URL=https://cms.wilyersignage.com/api

# ---- Maker user (uploads files / submits for approval) ----------------------
MAKER_EMAIL=amankumarbsrbsr@gmail.com
MAKER_PASSWORD=12345
MAKER_NAME=Aman Kumar

# ---- Checker user (approves / rejects uploads) ------------------------------
CHECKER_EMAIL=aman@wilyer.com
CHECKER_PASSWORD=12345
CHECKER_NAME=Aman (Checker)

# ---- Negative / restricted user (no upload permission) ----------------------
# Optional. Used by permission tests. Leave blank to skip those tests.
RESTRICTED_EMAIL=
RESTRICTED_PASSWORD=

# ---- IMAP (Gmail) email validation ------------------------------------------
# For Gmail use an App Password (https://myaccount.google.com/apppasswords),
# NOT the normal account password. IMAP must be enabled in Gmail settings.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=amankumarbsrbsr@gmail.com
IMAP_PASSWORD=your-gmail-app-password-here
IMAP_MAILBOX=INBOX

# Sender address the CMS sends notifications from (used to filter mail).
NOTIFICATION_FROM=no-reply@wilyer.com

# ---- Email polling tuning ---------------------------------------------------
EMAIL_POLL_TIMEOUT_MS=60000
EMAIL_POLL_INTERVAL_MS=5000

# ---- Execution tuning -------------------------------------------------------
HEADLESS=true
WORKERS=2
RETRIES=2
ACTION_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=10000

# ---- CI flag (set automatically in GitHub Actions) --------------------------
CI=false
