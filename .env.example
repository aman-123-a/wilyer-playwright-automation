# =============================================================================
#  Wilyer QA Automation — local environment template.
#  Copy to `.env` and fill in. `.env` is gitignored; never commit credentials.
#
#  Target servers are NOT configured here — they live in version control at
#  config/environments.ts. Pick one with an npm script:
#
#      npm run cms4   ->  https://cms4.pocsample.in  (Pre-Production 4)
#
#  For per-environment credentials, create `.env.cms4` and so on — those load
#  ahead of this file and are gitignored too.
# =============================================================================

# --- Credentials (required) --------------------------------------------------
# Admin / primary account with full access.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# --- RBAC role accounts (optional) -------------------------------------------
# One account per role you want covered. Suites SKIP the roles you leave blank
# rather than failing, so a partial setup still produces a useful run.
# There are deliberately no fallback values anywhere in the code: a committed
# fallback login is a credential leak whatever the intent behind it.
CMS_SUBUSER_EMAIL=
CMS_SUBUSER_PASSWORD=
# Account-wide sub-user: has a role, but no folder fence (isRestrictedAccess = false).
# CMS_RESTRICTED_* below is its opposite — a sub-user scoped to assigned folders.
CMS_UNRESTRICTED_EMAIL=
CMS_UNRESTRICTED_PASSWORD=
CMS_OWNER_EMAIL=
CMS_OWNER_PASSWORD=
CMS_SUPPORT_EMAIL=
CMS_SUPPORT_PASSWORD=
CMS_MAKER_EMAIL=
CMS_MAKER_PASSWORD=
CMS_CHECKER_EMAIL=
CMS_CHECKER_PASSWORD=
CMS_VIEWER_EMAIL=
CMS_VIEWER_PASSWORD=
CMS_RESTRICTED_EMAIL=
CMS_RESTRICTED_PASSWORD=

# Name of the role card the data-driven RBAC suite edits (Team -> Roles).
CMS_RBAC_ROLE=un

# --- Overrides (optional) ----------------------------------------------------
# Only set these to point at something other than the registry default, e.g. a
# local build, or the unconfirmed API host on cms3 / cms4. (cms, cms2 and live are
# verified — see docs/known-gaps.md section 1.)
# CMS_BASE_URL=
# CMS_API_BASE_URL=

# --- Behaviour toggles -------------------------------------------------------
# Allow suites that create / update / delete real data. Ignored (forced off) on
# the live environment, which stays read-only regardless of what is set here.
CMS_ALLOW_DESTRUCTIVE=false

# When true, console-error and failed-API monitors FAIL the test on violation.
# When false they only warn — useful against a noisy staging build.
CMS_STRICT_MONITORS=false

# --- Android player (device-side testing) ------------------------------------
# The CMS is only half the product; the other half is the player on the screen.
# Leave ANDROID_APP_PACKAGE blank and every player suite SKIPS — a laptop with
# no hardware attached still gets a green CMS run.
#
# Prerequisites:  adb on PATH, device visible in `adb devices`
#                 (networked box: `adb connect <ip>:5555`)
#                 Appium only for the UI suites:
#                   npm i -g appium && appium driver install uiautomator2 && appium
#
# Player APK package name — the single switch that enables the device suites.
ANDROID_APP_PACKAGE=
# Launcher activity. Usually inferred; set it if Appium cannot work it out.
ANDROID_APP_ACTIVITY=
# Device serial from `adb devices`. Blank = the only attached device. ALWAYS set
# this in a lab with more than one box, or runs report on the wrong screen.
ANDROID_DEVICE_UDID=
ANDROID_ADB_PATH=adb
ANDROID_APPIUM_URL=http://127.0.0.1:4723

# Where the player caches downloaded media. Defaults to the scoped-storage path
# derived from the package; override if the app writes somewhere else.
# ANDROID_MEDIA_DIR=
# logcat tag the player logs under — narrows a very noisy stream.
ANDROID_LOG_TAG=
# Regex with ONE capture group, matched against logcat to read what is on screen.
# Playback cannot be asserted without this; confirm what the app actually emits.
ANDROID_NOW_PLAYING_PATTERN=now playing[:\s]+(.+)

# End-to-end join: a playlist already assigned to THIS screen in the CMS, and a
# media filename inside it. Blank = the CMS-to-device suite skips.
ANDROID_TEST_PLAYLIST=
ANDROID_TEST_MEDIA=

# How long a publish may take to reach the device. This is a product SLA — if a
# run needs it raised, that is the finding, not the fix.
ANDROID_SYNC_TIMEOUT_MS=120000
ANDROID_ELEMENT_TIMEOUT_MS=15000
ANDROID_SESSION_TIMEOUT_MS=120000
ANDROID_REBOOT_TIMEOUT_MS=180000

# Resilience suites cut WiFi, force-stop the app and reboot the box. Harmless on
# a lab device, disruptive on one showing live content — so it is opt-in, and
# forced off on the production environment regardless of what is set here.
ANDROID_ALLOW_DISRUPTIVE=false

# Soak: minutes of continuous playback to observe. 0 = suite skipped.
ANDROID_SOAK_MINUTES=0
ANDROID_SOAK_MEMORY_GROWTH_PCT=50

# --- Clusters (synchronised playback across real screens) --------------------
# A cluster is two or more physical screens playing one playlist in step under
# an elected master. Leave CLUSTER_ID blank and every cluster suite SKIPS.
#
# The id is the last segment of /cluster-settings/<id> in the CMS. There is
# deliberately no default: a committed id points at a cluster that exists on one
# server and not the others, producing 404s that read like defects.
# (The suite was originally authored against "try cluster",
#  id 6a979dc496d249abd0118b63 — confirm it exists on your target before using it.)
CLUSTER_ID=

# How long the live channel gets to announce a master. Screens online with no
# master inside this window is a defect, not a slow network.
CLUSTER_ELECTION_TIMEOUT_MS=60000

# Failover drills block on a human pulling a network cable on a real screen.
# Harmless in a lab, disruptive on a panel showing live content — so they are
# opt-in, and forced off on production regardless of what is set here.
CLUSTER_DRILL=false
CLUSTER_DRILL_TIMEOUT_MS=180000

# The grace window the player is specified to keep playing through after losing
# the network. A product SLA — if a run needs it widened, that is the finding.
CLUSTER_GRACE_MIN_S=10
CLUSTER_GRACE_MAX_S=15

# Playback-sync measurement: how long to listen, and the largest master-to-slave
# gap accepted on a shared item.
CLUSTER_SYNC_WINDOW_MS=120000
CLUSTER_SYNC_TOLERANCE_MS=2000

# --- Performance budgets (ms) ------------------------------------------------
CMS_PERF_PAGE_LOAD_MS=5000
CMS_PERF_LISTING_LOAD_MS=4000
CMS_API_SLOW_MS=3000

# --- Lighthouse minimum category scores (0-100) ------------------------------
CMS_LH_PERFORMANCE=50
CMS_LH_ACCESSIBILITY=80
CMS_LH_BEST_PRACTICES=80
CMS_LH_SEO=80
