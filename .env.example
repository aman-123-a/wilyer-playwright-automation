# =============================================================================
#  Wilyer QA Automation — local environment template.
#  Copy to `.env` and fill in. `.env` is gitignored; never commit credentials.
#
#  Target servers are NOT configured here — they live in version control at
#  config/environments.ts. Pick one with an npm script:
#
#      npm run cms     ->  https://cms.pocsample.in       (Pre-Production 1)
#      npm run cms2    ->  https://cms2.pocsample.in      (Pre-Production 2)
#      npm run cms3    ->  https://cms3.pocsample.in      (Pre-Production 3)
#      npm run cms4    ->  https://cms4.pocsample.in      (Pre-Production 4)
#      npm run live    ->  https://cms.wilyersignage.com  (Production)
#
#  For per-environment credentials, create `.env.cms2` and so on — those load
#  ahead of this file and are gitignored too.
# =============================================================================

# --- Credentials (required) --------------------------------------------------
# Admin / primary account with full access.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Sub-user account with scoped / restricted access — needed by the RBAC suites.
CMS_SUBUSER_EMAIL=
CMS_SUBUSER_PASSWORD=

# --- Overrides (optional) ----------------------------------------------------
# Only set these to point at something other than the registry default, e.g. a
# local build, or the unconfirmed API host on cms3 / cms4 / live.
# CMS_BASE_URL=
# CMS_API_BASE_URL=

# --- Behaviour toggles -------------------------------------------------------
# Allow suites that create / update / delete real data. Ignored (forced off) on
# the live environment, which stays read-only regardless of what is set here.
CMS_ALLOW_DESTRUCTIVE=false

# When true, console-error and failed-API monitors FAIL the test on violation.
# When false they only warn — useful against a noisy staging build.
CMS_STRICT_MONITORS=false

# --- Performance budgets (ms) ------------------------------------------------
CMS_PERF_PAGE_LOAD_MS=5000
CMS_PERF_LISTING_LOAD_MS=4000
CMS_API_SLOW_MS=3000

# --- Lighthouse minimum category scores (0-100) ------------------------------
CMS_LH_PERFORMANCE=50
CMS_LH_ACCESSIBILITY=80
CMS_LH_BEST_PRACTICES=80
CMS_LH_SEO=80
