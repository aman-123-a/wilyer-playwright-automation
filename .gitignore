# =============================================================================
#  Wilyer QA Automation — ignore rules.
#  Principle: source and authored documents are tracked; anything a run can
#  regenerate, and anything holding a credential or a live session, is not.
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm/

# ── Secrets and sessions ─────────────────────────────────────────────────────
# Real env files anywhere. Only .env.example templates are tracked.
.env
.env.*
!.env.example
**/.env
# Cached storage-state (login cookies / JWTs) for every environment.
storage/
**/.auth/
/playwright/.auth/
# ClickUp API token.
clickup-config.json

# ── Generated test output ────────────────────────────────────────────────────
# Anchored to the repository root on purpose: an unanchored `reports/` also
# matches tests/reports/ (the Reports module's suite) and silently untracks it.
/reports/
/test-results/
/playwright-report/
/blob-report/
/lighthouse-reports/
**/test-results/
**/playwright-report/
**/allure-results/
**/allure-report/
/playwright/.cache/
*.log

# ── Archived legacy material ─────────────────────────────────────────────────
# legacy/ keeps the superseded suites' source, but not their debug artifacts.
legacy/scratch/
legacy/**/report/

# ── Tooling and local machine state ──────────────────────────────────────────
.playwright-mcp/
.code-review-graph/
browser-data/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Scratch ──────────────────────────────────────────────────────────────────
temp_doc*.docx
*.tmp
.DS_Store
Thumbs.db
